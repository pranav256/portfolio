{
  "version": 1,
  "product": "Pranav portfolio and writing",
  "features": [
    {
      "id": "home",
      "name": "Home",
      "flows": [
        {
          "id": "view-home",
          "name": "View home",
          "steps": [
            {
              "name": "Portfolio",
              "route": "/",
              "screen": "app/page.tsx",
              "components": [
                "components/site/header.tsx",
                "components/site/hero.tsx",
                "components/site/workbench-art.tsx",
                "components/site/projects.tsx",
                "components/site/project-art.tsx",
                "components/site/about.tsx",
                "components/site/writing.tsx",
                "components/site/contact.tsx",
                "components/site/footer.tsx",
                "components/site/artwork-motion.tsx"
              ],
              "data": [
                "lib/projects.ts",
                "lib/site.ts",
                "lib/posts.ts",
                "research/github-profile.json",
                "research/github-repositories.json"
              ]
            }
          ]
        }
      ],
      "components": []
    },
    {
      "id": "blog",
      "name": "Blog",
      "flows": [
        {
          "id": "view-blog-detail",
          "name": "View blog detail",
          "steps": [
            {
              "name": "All writing",
              "route": "/blog",
              "screen": "app/blog/page.tsx",
              "components": [
                "components/blog/post-list.tsx",
                "components/blog/post-search.tsx"
              ],
              "data": [
                "lib/posts.ts"
              ]
            },
            {
              "name": "Search and category results",
              "route": "/blog?q=NONCES&category=systems",
              "screen": "app/blog/page.tsx",
              "components": [
                "components/blog/post-search.tsx"
              ],
              "data": []
            },
            {
              "name": "Empty search",
              "route": "/blog?q=unlisted",
              "screen": "app/blog/page.tsx",
              "components": [
                "components/blog/post-search.tsx",
                "components/ui/empty.tsx"
              ],
              "data": []
            },
            {
              "name": "Unknown category",
              "route": "/blog?category=unlisted",
              "screen": "app/blog/page.tsx",
              "components": [
                "components/blog/post-search.tsx"
              ],
              "data": []
            },
            {
              "name": "An API can be a file",
              "route": "/blog/an-api-can-be-a-file",
              "screen": "app/blog/[slug]/page.tsx",
              "components": [
                "components/blog/article-outline.tsx",
                "components/blog/markdown.tsx",
                "components/ui/code-block.tsx",
                "components/ui/copy-button.tsx"
              ],
              "data": [
                "content/posts/an-api-can-be-a-file.md"
              ]
            },
            {
              "name": "Expanded mobile outline",
              "route": "/blog/an-api-can-be-a-file",
              "screen": "app/blog/[slug]/page.tsx",
              "action": "Open On this page below the article title on a narrow viewport",
              "components": [
                "components/blog/article-outline.tsx"
              ],
              "data": []
            },
            {
              "name": "Clipboard error",
              "route": "/blog/an-api-can-be-a-file",
              "screen": "app/blog/[slug]/page.tsx",
              "action": "Reject clipboard permission, then choose Copy code",
              "components": [
                "components/ui/copy-button.tsx"
              ],
              "data": []
            },
            {
              "name": "Local first by design",
              "route": "/blog/local-first-by-design",
              "screen": "app/blog/[slug]/page.tsx",
              "components": [
                "components/blog/article-outline.tsx",
                "components/blog/markdown.tsx"
              ],
              "data": [
                "content/posts/local-first-by-design.md"
              ]
            },
            {
              "name": "Small tools long half-lives",
              "route": "/blog/small-tools-long-half-lives",
              "screen": "app/blog/[slug]/page.tsx",
              "components": [
                "components/blog/article-outline.tsx",
                "components/blog/markdown.tsx"
              ],
              "data": [
                "content/posts/small-tools-long-half-lives.md"
              ]
            }
          ]
        }
      ],
      "components": []
    },
    {
      "id": "navigation-recovery",
      "name": "Navigation recovery",
      "flows": [
        {
          "id": "recover-from-a-missing-page",
          "name": "Recover from a missing page",
          "steps": [
            {
              "name": "Page not found",
              "route": "/missing-page",
              "screen": "app/not-found.tsx",
              "components": [
                "components/site/header.tsx",
                "components/site/footer.tsx"
              ],
              "data": []
            }
          ]
        }
      ],
      "components": []
    },
    {
      "id": "portable-content-and-discovery",
      "name": "Portable content and discovery",
      "description": "Non-UI routes are verified as HTTP responses rather than invented screens.",
      "flows": [
        {
          "id": "read-feeds-and-download-sources",
          "name": "Read feeds and download sources",
          "steps": [
            {
              "name": "RSS",
              "route": "/feed.xml",
              "components": [],
              "data": [
                "app/feed.xml/route.ts"
              ]
            },
            {
              "name": "Markdown source",
              "route": "/blog/:slug/source",
              "components": [],
              "data": [
                "app/blog/[slug]/source/route.ts"
              ]
            },
            {
              "name": "Sitemap",
              "route": "/sitemap.xml",
              "components": [],
              "data": [
                "app/sitemap.ts"
              ]
            },
            {
              "name": "Robots",
              "route": "/robots.txt",
              "components": [],
              "data": [
                "app/robots.ts"
              ]
            },
            {
              "name": "Social image",
              "route": "/opengraph-image.png",
              "components": [],
              "data": [
                "app/opengraph-image.png"
              ]
            },
            {
              "name": "Site icon",
              "route": "/icon.svg",
              "components": [],
              "data": [
                "app/icon.svg"
              ]
            }
          ]
        }
      ],
      "components": []
    }
  ]
}
